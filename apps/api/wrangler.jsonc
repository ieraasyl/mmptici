{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmptici",
  "account_id": "15da7213905a1f5b05432a12f9da2a13",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mmptici-db",
      "database_id": "7e0040a7-5369-44f3-b6b5-64d8645b3f93",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "workers_dev": true,
  "preview_urls": false,
}
